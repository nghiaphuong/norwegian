# ===== Norsk – biến môi trường =====
# Trên Hostinger: đặt trong phần Environment variables của ứng dụng Node.js.
# KHÔNG commit file .env thật lên GitHub (repo đang để public).

PORT=3000
TZ=Europe/Oslo
PUBLIC_URL=https://norsk.example.com

# MySQL (hPanel > Databases). Trên Hostinger dùng 127.0.0.1, không dùng srvNNNN.hstgr.io.
# Bỏ trống DB_NAME: app vẫn chạy nhưng không có tài khoản, đồng bộ, bảng xếp hạng.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u000000000_norsk
DB_USER=u000000000_norsk
DB_PASSWORD=change-me

# Ký phiên đăng nhập: chuỗi ngẫu nhiên dài ít nhất 32 ký tự
SESSION_SECRET=một-chuỗi-ngẫu-nhiên-dài

# Mã mời khi tạo tài khoản (bỏ trống = ai cũng đăng ký được)
INVITE_CODE=

# Tùy chọn: Gia sư AI (hội thoại nhập vai, sửa câu, giải thích câu). Bỏ trống = ẩn tính năng.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=60

# Tùy chọn: dịch nghĩa từ điển chính xác hơn bằng Google Cloud Translation (bỏ trống = MyMemory miễn phí)
GOOGLE_TRANSLATE_API_KEY=
# Email bất kỳ để MyMemory nâng hạn mức miễn phí từ 5.000 lên 50.000 ký tự/ngày
MYMEMORY_EMAIL=

# Tùy chọn: giọng đọc Na Uy chính thức của Google Cloud Text-to-Speech cho thiết bị không có giọng Na Uy.
# Bỏ trống = dùng giọng Google Dịch (miễn phí, không chính thức).
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=nb-NO-Wavenet-F
